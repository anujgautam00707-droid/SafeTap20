{
  "rules": {
    "sos": {
      ".read": false,
      ".write": false,
      "$sosId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
        "currentLocation": {
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'accuracy', 'timestamp'])"
        }
      }
    },
    "live_location_owners": {
      ".read": false,
      ".write": false,
      "$token": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
        ".validate": "newData.hasChild('userId') && newData.child('userId').val() === auth.uid"
      }
    },
    "live_locations": {
      ".read": false,
      ".write": false,
      "$token": {
        ".read": true,
        ".write": "auth != null && root.child('live_location_owners').child($token).child('userId').val() === auth.uid",
        ".validate": "newData.hasChildren(['latitude', 'longitude', 'status'])"
      }
    }
  }
}
